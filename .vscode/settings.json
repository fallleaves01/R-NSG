{
    "clangd.arguments": [
        "--compile-commands-dir=.vscode"
    ],
    "C_Cpp.default.compileCommands": [
        "${workspaceFolder}/.vscode/compile_commands.json"
    ],
    "files.associations": {
        "array": "cpp",
        "deque": "cpp",
        "string": "cpp",
        "vector": "cpp",
        "iterator": "cpp",
        "random": "cpp",
        "fstream": "cpp",
        "initializer_list": "cpp",
        "iosfwd": "cpp",
        "istream": "cpp",
        "tuple": "cpp",
        "type_traits": "cpp",
        "utility": "cpp"
    }
}